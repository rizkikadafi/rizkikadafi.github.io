---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 — Not Found">
  <Navbar />
  <main class="relative flex min-h-[70vh] items-center justify-center overflow-hidden px-6">
    <div
      class="pointer-events-none absolute -left-24 top-1/4 h-72 w-72 rounded-full bg-indigo-600/30 blur-[120px]"
    ></div>
    <div
      class="pointer-events-none absolute -right-24 bottom-1/4 h-72 w-72 rounded-full bg-cyan-500/25 blur-[120px]"
    ></div>

    <div class="glass-strong relative rounded-[2rem] p-10 text-center sm:p-14">
      <p class="font-display text-6xl font-extrabold text-gradient sm:text-7xl">404</p>
      <h1 class="mt-4 font-display text-xl font-semibold sm:text-2xl">Page not found</h1>
      <p class="mx-auto mt-3 max-w-sm text-sm text-(--muted)">
        The page you're looking for doesn't exist or has moved.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-500/30 transition duration-300 hover:-translate-y-0.5"
      >
        <i class="bi bi-house"></i>
        Back to home
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>