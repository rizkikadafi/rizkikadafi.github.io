---
import { getEntry } from 'astro:content';
import Reveal from './Reveal.astro';

const entry = await getEntry('site', 'site');
const { profile, stats, socials } = entry!.data;
---

<section id="hero" class="relative flex min-h-screen flex-col justify-center overflow-hidden py-32 sm:py-36">
  <div class="pointer-events-none absolute inset-0 grid-bg [mask-image:radial-gradient(ellipse_at_center,black_55%,transparent_85%)]"></div>
  <div
    class="pointer-events-none absolute -top-24 -left-24 h-96 w-96 rounded-full bg-indigo-600/35 blur-[120px] animate-float"
  ></div>
  <div
    class="pointer-events-none absolute top-1/3 -right-32 h-96 w-96 rounded-full bg-purple-600/30 blur-[120px] animate-float-slow"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-32 left-1/3 h-80 w-80 rounded-full bg-cyan-500/25 blur-[120px] animate-float"
  ></div>

  <div class="relative mx-auto w-full max-w-6xl px-6 sm:px-10">
    <Reveal>
      <div class="glass inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-medium text-(--muted) sm:text-sm">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
        </span>
        {profile.availability}
      </div>
    </Reveal>

    <Reveal delay={80}>
      <h1 class="mt-6 font-display text-4xl font-extrabold leading-tight sm:text-6xl lg:text-7xl">
        Hi, I'm <span class="text-gradient">{profile.name}</span>
      </h1>
    </Reveal>

    <Reveal delay={160}>
      <p class="mt-4 font-display text-xl font-semibold text-(--muted) sm:text-2xl lg:text-3xl">
        <span class="text-(--text)">{''}I'm a{' '}</span>
        <span id="typed-text" class="text-cyan-300 light:text-cyan-600"></span>
        <span class="typed-cursor text-cyan-300 light:text-cyan-600">|</span>
      </p>
    </Reveal>

    <Reveal delay={240}>
      <p class="mt-5 max-w-2xl text-sm leading-relaxed text-(--muted) sm:text-base lg:text-lg">
        {profile.tagline}
      </p>
    </Reveal>

    <Reveal delay={320}>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/#projects"
          class="group inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-500/30 transition duration-300 hover:-translate-y-0.5 hover:shadow-indigo-500/50"
        >
          View Projects
          <i class="bi bi-arrow-right transition-transform group-hover:translate-x-1"></i>
        </a>
        <a
          href="/#contact"
          class="glass inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold transition duration-300 hover:-translate-y-0.5"
        >
          <i class="bi bi-envelope"></i>
          Contact Me
        </a>
      </div>
    </Reveal>

    <Reveal delay={400}>
      <div class="mt-8 flex items-center gap-3">
        {socials.map((s) => (
          <a
            href={s.link}
            target="_blank"
            rel="noopener"
            aria-label={s.name}
            title={s.name}
            class="glass grid h-11 w-11 place-items-center rounded-xl text-lg text-(--muted) transition duration-300 hover:-translate-y-1 hover:text-[#22d3ee]"
          >
            <i class={`bi bi-${s.icon}`}></i>
          </a>
        ))}
      </div>
    </Reveal>
  </div>

  <div class="relative mx-auto mt-16 w-full max-w-6xl px-6 sm:px-10">
    <Reveal delay={480}>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="glass rounded-2xl p-4 text-center sm:p-5">
            <div class="font-display text-2xl font-bold text-gradient sm:text-3xl">{s.value}</div>
            <div class="mt-1 text-xs text-(--muted) sm:text-sm">{s.label}</div>
          </div>
        ))}
      </div>
    </Reveal>
  </div>

  <a
    href="/#about"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-2xl text-(--muted) transition hover:text-(--text) animate-bounce"
    aria-label="Scroll down"
  >
    <i class="bi bi-chevron-double-down"></i>
  </a>
</section>

<script is:inline define:vars={{ roles: profile.roles }}>
  const el = document.getElementById('typed-text');
  const typedRoles = roles;

  let roleIndex = 0;
  let charIndex = 0;
  let deleting = false;

  const tick = () => {
    const current = typedRoles[roleIndex];
    if (!deleting) {
      el.textContent = current.slice(0, ++charIndex);
      if (charIndex === current.length) {
        deleting = true;
        setTimeout(tick, 1600);
        return;
      }
      setTimeout(tick, 70);
    } else {
      el.textContent = current.slice(0, --charIndex);
      if (charIndex === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % typedRoles.length;
      }
      setTimeout(tick, 40);
    }
  };

  tick();
</script>
