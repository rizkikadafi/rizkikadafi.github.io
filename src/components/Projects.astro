---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import Reveal from './Reveal.astro';

interface Props {
  featuredOnly?: boolean;
  showViewAll?: boolean;
}

const { featuredOnly = true, showViewAll = true } = Astro.props;
const all = await getCollection('projects');
const items = (featuredOnly ? all.filter((p) => p.data.featured) : all)
  .map((p) => p.data)
  .sort((a, b) => b.year - a.year);
---

<section id="projects" class="relative py-20 sm:py-28">
  <div class="mx-auto w-full max-w-6xl px-6 sm:px-10">
    {featuredOnly ? (
      <SectionHeading title="Projects" subtitle="Things I have built" />
    ) : (
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4 sm:px-4">
        <div>
          <h2 class="font-display text-2xl font-bold sm:text-3xl lg:text-4xl">
            <span class="bg-gradient-to-r from-indigo-300 via-purple-300 to-cyan-300 bg-clip-text text-transparent light:from-indigo-500 light:via-purple-500 light:to-cyan-500">
              All Projects
            </span>
          </h2>
          <p class="mt-2 text-sm text-(--muted)">Things I have built</p>
        </div>
        <a href="/#projects" class="text-sm text-(--muted) transition hover:text-(--text)">
          <i class="bi bi-arrow-left mr-1"></i> Back to home
        </a>
      </div>
    )}

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item, i) => (
        <Reveal delay={(i % 3) * 80}>
          <article
            class="glass group flex h-full flex-col overflow-hidden rounded-2xl transition duration-300 hover:-translate-y-2 hover:border-indigo-400/40 hover:shadow-[0_0_50px_-15px_rgba(99,102,241,0.5)]"
          >
            <div class="relative overflow-hidden">
              <img
                src={item.img}
                alt={item.name}
                loading="lazy"
                class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition duration-300 group-hover:opacity-100"
              ></div>
              {item.featured && (
                <span
                  class="absolute left-3 top-3 rounded-full border border-indigo-400/40 bg-black/40 px-3 py-1 text-xs font-medium text-indigo-200 backdrop-blur-md"
                >
                  ★ Featured
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-display text-base font-semibold sm:text-lg">{item.name}</h3>
                {item.year && <span class="shrink-0 text-xs text-(--muted)">{item.year}</span>}
              </div>
              <p class="mt-1.5 flex-1 text-sm leading-relaxed text-(--muted)">{item.desc}</p>

              <div class="mt-4 flex flex-wrap gap-2">
                {item.tech.map((t) => (
                  <span
                    class="rounded-full border border-(--line) bg-white/5 px-2.5 py-1 text-xs text-(--muted)"
                  >
                    {t}
                  </span>
                ))}
              </div>

              <div class="mt-4 flex items-center gap-2 border-t border-(--line) pt-4 text-xl">
                {item.links?.github && (
                  <a
                    href={item.links.github}
                    target="_blank"
                    rel="noopener"
                    title="GitHub"
                    class="grid h-9 w-9 place-items-center rounded-lg text-(--muted) transition hover:bg-white/5 hover:text-[#818cf8]"
                  >
                    <i class="bi bi-github"></i>
                  </a>
                )}
                {item.links?.blog && (
                  <a
                    href={item.links.blog}
                    target="_blank"
                    rel="noopener"
                    title="Blog post"
                    class="grid h-9 w-9 place-items-center rounded-lg text-(--muted) transition hover:bg-white/5 hover:text-[#a78bfa]"
                  >
                    <i class="bi bi-pencil-square"></i>
                  </a>
                )}
                {item.links?.deployment && (
                  <a
                    href={item.links.deployment}
                    target="_blank"
                    rel="noopener"
                    title="Live demo"
                    class="grid h-9 w-9 place-items-center rounded-lg text-(--muted) transition hover:bg-white/5 hover:text-[#22d3ee]"
                  >
                    <i class="bi bi-link-45deg"></i>
                  </a>
                )}
              </div>
            </div>
          </article>
        </Reveal>
      ))}
    </div>

    {showViewAll && (
      <div class="mt-10 text-center">
        <a
          href="/projects"
          class="glass group inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold transition duration-300 hover:-translate-y-0.5"
        >
          View all projects
          <i class="bi bi-arrow-right transition-transform group-hover:translate-x-1"></i>
        </a>
      </div>
    )}
  </div>
</section>