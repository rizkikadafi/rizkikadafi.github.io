---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import Reveal from './Reveal.astro';

const entries = (await getCollection('experience'))
  .map((entry) => entry.data)
  .sort((a, b) => b.order - a.order);
---

<section id="experience" class="relative py-20 sm:py-28">
  <div class="mx-auto w-full max-w-4xl px-6 sm:px-10">
    <SectionHeading title="Experience" subtitle="My journey so far" />

    <div class="relative">
      <div class="absolute bottom-4 left-[7px] top-4 w-px bg-gradient-to-b from-indigo-500/60 via-purple-500/40 to-transparent"></div>

      <div class="space-y-10">
        {entries.map((item, i) => (
          <Reveal delay={i * 100}>
            <div class="relative pl-10">
              <span
                class="absolute left-0 top-1.5 h-[15px] w-[15px] rounded-full border-2 border-cyan-400 bg-(--bg) shadow-[0_0_16px_rgba(34,211,238,0.7)]"
              ></span>

              <div class="glass rounded-2xl p-6 transition duration-300 hover:-translate-y-1 hover:border-indigo-400/40">
                <div class="flex flex-wrap items-center gap-3">
                  <span
                    class="rounded-full border border-(--line) bg-white/5 px-3 py-1 text-xs font-medium text-cyan-300 light:text-cyan-600"
                  >
                    {item.period}
                  </span>
                  {item.placeholder && (
                    <span
                      class="rounded-full border border-amber-400/40 bg-amber-400/10 px-3 py-1 text-xs font-medium text-amber-300 light:text-amber-600"
                    >
                      * Data contoh — ganti dengan milikmu
                    </span>
                  )}
                </div>

                <h3 class="mt-3 font-display text-lg font-semibold sm:text-xl">{item.role}</h3>
                <p class="mt-0.5 text-sm font-medium text-(--muted)">{item.company}</p>

                <ul class="mt-4 space-y-2">
                  {item.bullets.map((b) => (
                    <li class="flex gap-2 text-sm text-(--muted)">
                      <i class="bi bi-chevron-right mt-0.5 text-xs text-indigo-400"></i>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </div>
</section>