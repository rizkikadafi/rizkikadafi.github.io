---
const navItems = [
  { name: 'Home', link: '/#hero' },
  { name: 'About', link: '/#about' },
  { name: 'Experience', link: '/#experience' },
  { name: 'Education', link: '/#education' },
  { name: 'Skills', link: '/#skills' },
  { name: 'Projects', link: '/#projects' },
];
---

<header class="fixed inset-x-4 top-4 z-50">
  <nav
    id="site-nav"
    class="glass flex h-14 items-center justify-between rounded-2xl px-4 shadow-lg shadow-black/10 transition-all duration-300 sm:px-5"
  >
    <a href="/#hero" class="flex items-center gap-2 font-display font-bold">
      <img src="/assets/image/favicon.png" alt="Logo Rizki Kadafi" width="28" height="28" class="rounded-md" />
      <span class="text-sm sm:text-base">Rizki Kadafi</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {navItems.map((item) => (
        <a
          href={item.link}
          class="rounded-lg px-3 py-2 text-sm text-(--muted) transition-colors hover:text-(--text) hover:bg-white/5"
        >
          {item.name}
        </a>
      ))}
      <a
        href="https://rizkikadafi.github.io/blog"
        target="_blank"
        rel="noopener"
        class="rounded-lg px-3 py-2 text-sm text-(--muted) transition-colors hover:text-(--text) hover:bg-white/5"
      >
        Blog
        <i class="bi bi-box-arrow-up-right ml-1 text-xs"></i>
      </a>
    </div>

    <div class="flex items-center gap-2">
      <button
        class="theme-toggle grid h-9 w-9 place-items-center rounded-lg text-lg text-(--muted) transition hover:text-(--text) hover:bg-white/5"
        aria-label="Toggle theme"
      >
        <i class="bi bi-sun text-(--text) hidden light:block"></i>
        <i class="bi bi-moon-stars text-(--text) light:hidden"></i>
      </button>
      <button
        id="menu-btn"
        class="grid h-9 w-9 place-items-center rounded-lg text-xl text-(--muted) transition hover:text-(--text) hover:bg-white/5 md:hidden"
        aria-label="Open menu"
      >
        <i class="bi bi-list text-(--text)"></i>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="glass-strong invisible fixed inset-x-4 top-[4.5rem] z-50 translate-y-2 rounded-2xl p-3 opacity-0 transition-all duration-300 md:hidden"
  >
    {navItems.map((item) => (
      <a
        href={item.link}
        class="mobile-menu-link block rounded-xl px-4 py-3 text-(--muted) transition hover:bg-white/5 hover:text-(--text)"
      >
        {item.name}
      </a>
    ))}
    <a
      href="https://rizkikadafi.github.io/blog"
      target="_blank"
      rel="noopener"
      class="mobile-menu-link block rounded-xl px-4 py-3 text-(--muted) transition hover:bg-white/5 hover:text-(--text)"
    >
      Blog <i class="bi bi-box-arrow-up-right ml-1 text-xs"></i>
    </a>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav')!;

  const onScroll = () => {
    if (window.scrollY > 24) {
      nav.classList.add('shadow-xl', 'shadow-black/40');
    } else {
      nav.classList.remove('shadow-xl', 'shadow-black/40');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const menuBtn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const html = document.documentElement;

  const toggleMenu = (open?: boolean) => {
    const isOpen = open ?? menu?.classList.contains('opacity-0');
    menu?.classList.toggle('opacity-0', !isOpen);
    menu?.classList.toggle('invisible', !isOpen);
    menu?.classList.toggle('translate-y-2', !isOpen);
    html.classList.toggle('overflow-hidden', !!isOpen);
  };

  menuBtn?.addEventListener('click', () => toggleMenu());
  document.querySelectorAll('.mobile-menu-link').forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });
</script>